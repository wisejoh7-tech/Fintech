# Reallapp Render production environment
# Add these in Render Dashboard > Web Service > Environment.
# Do not commit real values to GitHub.

NODE_ENV=production

# Render does not provide MySQL automatically in this Blueprint.
# Use an external MySQL-compatible provider and include TLS parameters when required.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME?sslaccept=strict

# Optional Redis provider. Required for Redis-backed queues or multi-instance Socket.IO.
REDIS_URL=redis://REDIS_USER:REDIS_PASSWORD@REDIS_HOST:6379

# Server-side provider secrets. Never prefix these with VITE_.
GEMINI_API_KEY=replace-with-your-gemini-api-key
PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key
ENCRYPTION_KEY=generate-a-long-random-secret-at-least-32-characters

# Paste the complete Firebase Admin service-account JSON object on one line.
# It must contain type, project_id, private_key, and client_email.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Optional monitoring and email variables, only if those services are enabled.
SENTRY_DSN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Only set this when the frontend is hosted separately from Render, such as Vercel.
# For a same-origin Render deployment, leave it empty.
VITE_API_URL=
