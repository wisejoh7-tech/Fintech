# GEMINI_API_KEY: Server-side key required for Gemini AI API calls.
# Keep this value in protected project secrets; never expose it as a VITE_* variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database (managed MySQL-compatible connection for this project)
DATABASE_URL="mysql://user:password@localhost:3306/viva"

# Redis
REDIS_URL="redis://localhost:6379"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxx"

# Encryption Key (Used for BVN/sensitive data encryption)
ENCRYPTION_KEY="your-encryption-secret-key"

# Sentry Monitoring (Optional)
SENTRY_DSN=""

# Mobile / Desktop / External API base URL (Vite frontend config)
VITE_API_URL=""

# Firebase Service Account (JSON string on one line)
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'

# Email Configuration (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
